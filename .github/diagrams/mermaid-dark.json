    "edgeLabelBackground": "#050505",
    "actorBkg": "#141414",
    "actorBorder": "#E04D26",
    "actorTextColor": "#FFFFFF",
    "actorLineColor": "#3A3A3A",
    "signalColor": "#8A8A8A",
    "signalTextColor": "#FFFFFF",
    "labelBoxBkgColor": "#141414",
    "labelBoxBorderColor": "#3A3A3A",
    "labelTextColor": "#FFFFFF",
    "loopTextColor": "#FFFFFF",
