flowchart TB
  gp(["General Protocols<br/>signs each market's price about once a minute"])
  subgraph you["You"]
    direction LR
    wallet["Your Bitcoin Cash wallet"]
    browser["Jōge in your browser<br/>builds entries from live coins"]
  end
  subgraph chain["Bitcoin Cash mainnet"]
    direction LR
    round["Round contracts<br/>lane threads · gates · masters · tickets"]
    vaults["Agent vaults<br/>bet only for their owner"]
  end
  subgraph servers["Jōge servers"]
    direction LR
    keeper["Keeper<br/>open · lock · settle · pay"]
    agents["Agents<br/>read · gate · sign bets"]
    indexer["Indexer + oracle relay<br/>chain and prices → Postgres"]
    web["Web app<br/>pages · API · live stream · Sensei"]
  end
  wallet <-->|"WizardConnect: pair · sign"| browser
  browser ==>|"1 · enter"| round
  round ==>|"3 · payout to your address"| wallet
  keeper ==>|"2 · lock · settle · pay"| round
  agents ==>|"bet"| vaults
  vaults ==>|"enter"| round
  gp -.->|"signed prices, checked on chain"| round
  gp -.-> indexer
  indexer -.-> web
  web -.->|"live stream"| browser
  classDef brand fill:#e04d26,stroke:#e04d26,color:#ffffff
  class round brand
