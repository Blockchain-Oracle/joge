# Jōge web app: copy to apps/web/.env.local and fill in. Never commit the real file.
# Only DATABASE_URL is required.

DATABASE_URL=postgres://joge:joge@localhost:5432/joge
# Where a first visit lands: chipnet or mainnet
JOGE_DEFAULT_NETWORK=chipnet
# "true" once the mainnet deployment exists
NEXT_PUBLIC_JOGE_MAINNET_LIVE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3300

# Sensei and the agent studio's dry reads
OPENAI_API_KEY=
AI_MODEL=openai/gpt-5.4-mini

# Agents: the master public keys (the engine holds the private halves)
AGENT_XPUB=
AGENT_XPUB_MAINNET=
# Signs sign-in session cookies (32+ random characters)
AUTH_SECRET=

# Web Push (the engine's VAPID public key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# BCH BLAZE banner
NEXT_PUBLIC_REPO_URL=https://github.com/Blockchain-Oracle/joge
NEXT_PUBLIC_CASHTOKENS_ADDRESS=
