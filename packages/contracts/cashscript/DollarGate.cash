pragma cashscript ^0.14.0;

import "./dollar.cash";

// A dollar event's entry gate (stake class CLASS_DOLLAR): the same totals as EventGate, but the stakes are dollar
// tokens held by the gate's sidecar (input 1) rather than satoshis held by the gate. Players may leave before the lock.
contract DollarGate(bytes32 category, bytes ticketLockingBytecode, bytes sideLockingBytecode, bytes32 dollarCategory) {
    // Gate at input 0, its sidecar at input 1, the player's coins after (satoshis, and dollars for the stake).
    // Outputs: the gate, the sidecar with the stake added, the ticket, then at most two change outputs.
    function enter(int outcome, int stake, bytes20 payoutPkh) {
        require(this.activeInputIndex == 0, "the gate must be input 0");
        require(tx.inputs[0].tokenCategory == category + 0x02, "input 0 must be a gate");
        bytes state = tx.inputs[0].nftCommitment;
        require(state.slice(0, 1) == TAG_GATE, "not a gate commitment");
        int classAndOutcomes = int(state.slice(6, 7));
        require(classAndOutcomes / NIBBLE == CLASS_DOLLAR, "not a dollar gate");
        int outcomes = classAndOutcomes % NIBBLE;
        require(within(outcome, 0, outcomes), "no such outcome");
        require(within(stake, DOLLAR_MIN_STAKE, DOLLAR_MAX_STAKE + 1), "stake outside a dollar event's bounds");
        require(isSide(1, sideLockingBytecode, dollarCategory), "input 1 must be the gate's sidecar");

        int start = 10 + outcome * 5;
        int total = int(state.slice(start, start + 5));
        int entrants = int(state.slice(7, 10));
        bytes next = state.slice(0, 7) + toPaddedBytes(entrants + 1, 3) + state.slice(10, start)
            + toPaddedBytes(total + stake, 5) + state.slice(start + 5, state.length);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "gate must come back to itself");
        require(tx.outputs[0].tokenCategory == category + 0x02, "gate keeps its minting NFT");
        require(tx.outputs[0].tokenAmount == 0, "no fungible tokens on the gate");
        require(tx.outputs[0].nftCommitment == next, "gate totals must add this stake");
        require(tx.outputs[0].value == tx.inputs[0].value, "the gate's satoshis do not change");

        int held = tx.inputs[1].tokenAmount + stake;
        require(held - SIDE_SEED <= DOLLAR_GATE_CAP, "gate is full");
        require(requireSideOut(1, sideLockingBytecode, dollarCategory, held), "the sidecar must hold the stake");
        require(tx.outputs[1].value == tx.inputs[1].value, "the sidecar's satoshis do not change");

        bytes ticket = TAG_TICKET + state.slice(1, 6) + toPaddedBytes(outcome, 1) + toPaddedBytes(stake, 5) + payoutPkh;
        require(tx.outputs[2].lockingBytecode == ticketLockingBytecode, "output 2 must be the ticket");
        require(tx.outputs[2].tokenCategory == category, "ticket is an immutable NFT of the round's category");
        require(tx.outputs[2].tokenAmount == 0, "no fungible tokens on the ticket");
        require(tx.outputs[2].nftCommitment == ticket, "ticket must record round, gate, outcome, stake and payee");
        require(tx.outputs[2].value == TICKET_DUST, "ticket carries the fixed dust");

        // The player's coins and change carry satoshis or dollars only; no NFT of any kind moves in or out.
        for (int i = 2; i < tx.inputs.length; i++) {
            bytes funding = tx.inputs[i].tokenCategory;
            require(funding == 0x || funding == dollarCategory, "funding carries only satoshis or dollars");
        }
        require(tx.outputs.length <= 5, "at most gate, sidecar, ticket and two change outputs");
        for (int o = 3; o < tx.outputs.length; o++) {
            bytes change = tx.outputs[o].tokenCategory;
            require(change == 0x || change == dollarCategory, "change carries only satoshis or dollars");
        }
        require(requireNoOtherSides(2, 2, sideLockingBytecode), "only the gate's own sidecar");
    }

    // The round's lock spends every gate with its master; DollarMasterOpen checks everything else.
    function merge() {
        bytes own = tx.inputs[this.activeInputIndex].nftCommitment;
        bytes master = tx.inputs[0].nftCommitment;
        require(tx.inputs[0].tokenCategory == category + 0x01, "input 0 must be the round master");
        require(master.slice(0, 1) == TAG_MASTER, "not a master commitment");
        require(master.slice(5, 6) == STATE_OPEN, "the round is not open");
        require(master.slice(1, 5) == own.slice(1, 5), "the master belongs to another round");
    }

    // An entrant leaves before the lock: input 1 the gate's sidecar, input 2 their ticket from this gate, input 3 a
    // coin from the ticket's payout address signed with SIGHASH_ALL. The gate drops the stake, the sidecar keeps the
    // exit fee for the winners, and output 2 refunds the rest in dollars with the ticket's dust.
    function exit() {
        require(this.activeInputIndex == 0, "the gate must be input 0");
        require(tx.inputs.length == 4, "gate, sidecar, ticket and the owner's coin only");
        require(tx.inputs[0].tokenCategory == category + 0x02, "input 0 must be a gate");
        bytes state = tx.inputs[0].nftCommitment;
        require(state.slice(0, 1) == TAG_GATE, "not a gate commitment");
        require(int(state.slice(6, 7)) / NIBBLE == CLASS_DOLLAR, "not a dollar gate");
        require(isSide(1, sideLockingBytecode, dollarCategory), "input 1 must be the gate's sidecar");

        bytes ticket = tx.inputs[2].nftCommitment;
        require(tx.inputs[2].tokenCategory == category, "input 2 must be a ticket of this category");
        require(tx.inputs[2].lockingBytecode == ticketLockingBytecode, "input 2 must sit at the ticket contract");
        require(ticket.slice(0, 1) == TAG_TICKET, "not a ticket commitment");
        require(ticket.slice(1, 6) == state.slice(1, 6), "the ticket belongs to another round or gate");
        bytes owner = new LockingBytecodeP2PKH(unsafe_bytes20(ticket.slice(12, 32)));

        bytes ownerUnlock = tx.inputs[3].unlockingBytecode;
        require(tx.inputs[3].lockingBytecode == owner, "the ticket's owner must co-sign");
        require(tx.inputs[3].tokenCategory == 0x, "the owner's coin carries no tokens");
        require(ownerUnlock.slice(0, 1) == SIGNATURE_PUSH, "the owner signs with Schnorr");
        bytes sighash = ownerUnlock.slice(SIGHASH_BYTE, SIGHASH_BYTE + 1);
        require(sighash == 0x41 || sighash == 0x61, "the owner's signature must cover every output");

        int outcome = int(ticket.slice(6, 7));
        int stake = int(ticket.slice(7, 12));
        int start = 10 + outcome * 5;
        int total = int(state.slice(start, start + 5));
        int entrants = int(state.slice(7, 10));
        require(total >= stake && entrants > 0, "the gate holds this entry");
        bytes next = state.slice(0, 7) + toPaddedBytes(entrants - 1, 3) + state.slice(10, start)
            + toPaddedBytes(total - stake, 5) + state.slice(start + 5, state.length);
        int fee = stake * EVENT_EXIT_FEE_BPS / BPS;

        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "gate must come back to itself");
        require(tx.outputs[0].tokenCategory == category + 0x02, "gate keeps its minting NFT");
        require(tx.outputs[0].tokenAmount == 0, "no fungible tokens on the gate");
        require(tx.outputs[0].nftCommitment == next, "gate totals must drop this stake");
        require(tx.outputs[0].value == tx.inputs[0].value, "the gate's satoshis do not change");
        require(
            requireSideOut(1, sideLockingBytecode, dollarCategory, tx.inputs[1].tokenAmount - stake + fee),
            "the exit fee stays in the sidecar"
        );
        require(tx.outputs[1].value == tx.inputs[1].value, "the sidecar's satoshis do not change");
        require(tx.outputs[2].lockingBytecode == owner, "the refund goes to the ticket's owner");
        require(tx.outputs[2].tokenCategory == dollarCategory, "the refund is in dollars");
        require(tx.outputs[2].tokenAmount == stake - fee, "refund: the stake minus the exit fee");
        require(tx.outputs[2].value == tx.inputs[2].value, "the ticket's dust comes back with it");
        bool changeIsPlain = true;
        if (tx.outputs.length == 4) {
            changeIsPlain = tx.outputs[3].tokenCategory == 0x;
        }
        require(tx.outputs.length <= 4 && changeIsPlain, "at most gate, sidecar, refund and the owner's change");
        require(requireNoOtherSides(2, 2, sideLockingBytecode), "only the gate's own sidecar");
    }
}
