pragma cashscript ^0.14.0;

import "./entry.cash";

// An event's entry gate: the same as Gate, plus `exit` — an entrant may leave before the lock (event stake class only).
contract EventGate(bytes32 category, bytes ticketLockingBytecode) {
    function enter(int outcome, int stake, bytes20 payoutPkh) {
        require(this.activeInputIndex == 0, "the gate must be input 0");
        require(requireEntry(category, ticketLockingBytecode, outcome, stake, payoutPkh), "entry must be exact");
    }

    function merge() {
        require(requireMerge(category, tx.inputs[this.activeInputIndex].nftCommitment), "only the round's own lock merges a gate");
    }

    // An event entrant leaves before the lock: input 1 is their ticket from this gate, input 2 a coin from the ticket's
    // payout address signed with SIGHASH_ALL (so no old, partial signature can be replayed into an exit). Output 0 is
    // the gate without that stake (the exit fee stays behind for the winners), output 1 the refund to the owner.
    function exit() {
        require(this.activeInputIndex == 0, "the gate must be input 0");
        require(tx.inputs[0].tokenCategory == category + 0x02, "input 0 must be a gate");
        bytes state = tx.inputs[0].nftCommitment;
        require(state.slice(0, 1) == TAG_GATE, "not a gate commitment");
        require(int(state.slice(6, 7)) / NIBBLE == CLASS_EVENT, "only events allow leaving before the lock");

        bytes ticket = tx.inputs[1].nftCommitment;
        require(tx.inputs[1].tokenCategory == category, "input 1 must be a ticket of this category");
        require(tx.inputs[1].lockingBytecode == ticketLockingBytecode, "input 1 must sit at the ticket contract");
        require(ticket.slice(0, 1) == TAG_TICKET, "not a ticket commitment");
        require(ticket.slice(1, 6) == state.slice(1, 6), "the ticket belongs to another round or gate");
        bytes owner = new LockingBytecodeP2PKH(unsafe_bytes20(ticket.slice(12, 32)));

        bytes ownerUnlock = tx.inputs[2].unlockingBytecode;
        require(tx.inputs[2].lockingBytecode == owner, "the ticket's owner must co-sign");
        require(tx.inputs[2].tokenCategory == 0x, "the owner's coin carries no tokens");
        require(ownerUnlock.slice(0, 1) == SIGNATURE_PUSH, "the owner signs with Schnorr");
        bytes sighash = ownerUnlock.slice(SIGHASH_BYTE, SIGHASH_BYTE + 1);
        require(sighash == 0x41 || sighash == 0x61, "the owner's signature must cover every output");
        require(tx.inputs.length == 3, "gate, ticket and the owner's coin only");

        int outcome = int(ticket.slice(6, 7));
        int stake = int(ticket.slice(7, 12));
        int start = 10 + outcome * 5;
        int total = int(state.slice(start, start + 5));
        int entrants = int(state.slice(7, 10));
        require(total >= stake && entrants > 0, "the gate holds this entry");
        bytes next = state.slice(0, 7) + toPaddedBytes(entrants - 1, 3) + state.slice(10, start)
            + toPaddedBytes(total - stake, 5) + state.slice(start + 5, state.length);
        int fee = stake * EVENT_EXIT_FEE_BPS / BPS;

        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "gate must come back to itself");
        require(tx.outputs[0].tokenCategory == category + 0x02, "gate keeps its minting NFT");
        require(tx.outputs[0].tokenAmount == 0, "no fungible tokens");
        require(tx.outputs[0].nftCommitment == next, "gate totals must drop this stake");
        require(tx.outputs[0].value == tx.inputs[0].value - stake + fee, "the exit fee stays in the gate");
        require(tx.outputs[1].lockingBytecode == owner, "the refund goes to the ticket's owner");
        require(tx.outputs[1].value == stake - fee + tx.inputs[1].value, "refund: stake minus the exit fee, plus the ticket's dust");
        require(tx.outputs[1].tokenCategory == 0x, "the refund carries no tokens");
        bool changeIsPlain = true;
        if (tx.outputs.length == 3) {
            changeIsPlain = tx.outputs[2].tokenCategory == 0x;
        }
        require(tx.outputs.length <= 3 && changeIsPlain, "at most gate, refund and the owner's change");
    }
}
