pragma cashscript ^0.14.0;

// General Protocols price messages, as verified by AnyHedge v0.12 (contract.cash l.73-94).
// A message is 16 bytes of little-endian script numbers:
//   [0,4) message timestamp · [4,8) message sequence · [8,12) data sequence · [12,16) price.
// A data sequence <= 0 marks a metadata message, which is never a price.

int constant MESSAGE_BYTES = 16;
int constant DATASIG_BYTES = 64;

function messageTimestamp(bytes message) returns (int) {
    return int(message.slice(0, 4));
}

function dataSequence(bytes message) returns (int) {
    return int(message.slice(8, 12));
}

function messagePrice(bytes message) returns (int) {
    return int(message.slice(12, 16));
}

// Proves `message` is a signed price message from `oracle`. Fixed lengths keep every proof byte-identical.
function requireSignedPrice(bytes message, datasig signature, pubkey oracle) {
    require(message.length == MESSAGE_BYTES, "oracle message must be 16 bytes");
    require(bytes(signature).length == DATASIG_BYTES, "oracle signature must be 64 bytes");
    require(checkDataSig(signature, message, oracle), "oracle signature does not verify");
    require(dataSequence(message) > 0, "metadata message is not a price");
    require(messagePrice(message) > 0, "oracle price must be positive");
}

// Proves `first` is the oracle's first price message at or after `boundary`: the previous message (consecutive data
// sequence) is strictly before the boundary. Returns the first message's data sequence.
function firstAtOrAfter(
    bytes previous,
    datasig previousSignature,
    bytes first,
    datasig firstSignature,
    pubkey oracle,
    int boundary
) returns (int) {
    requireSignedPrice(previous, previousSignature, oracle);
    requireSignedPrice(first, firstSignature, oracle);
    require(dataSequence(first) == dataSequence(previous) + 1, "oracle messages must be consecutive");
    require(messageTimestamp(previous) < boundary, "previous message must be before the boundary");
    require(messageTimestamp(first) >= boundary, "first message must be at or after the boundary");
    return dataSequence(first);
}

// Proves `message` is the oracle's price with data sequence `sequence` and returns its price.
function priceAtSequence(bytes message, datasig signature, pubkey oracle, int sequence) returns (int) {
    requireSignedPrice(message, signature, oracle);
    require(dataSequence(message) == sequence, "strike must be the message after the lock message");
    return messagePrice(message);
}
