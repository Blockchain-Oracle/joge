pragma cashscript ^0.14.0;

// Jōge's shared rules: NFT tags, round states, stake classes and fixed lifecycle fees.
// Every number here is mirrored in packages/sdk/src/round/constants.ts; change both together.

// First byte of every commitment of category K.
bytes constant TAG_MASTER = 0x01;
bytes constant TAG_GATE = 0x02;
bytes constant TAG_TICKET = 0x03;

// Master state byte (offset 5).
bytes constant STATE_OPEN = 0x00;
bytes constant STATE_LOCKED = 0x01;
int constant STATE_SETTLED = 2;
int constant STATE_VOID = 3;

// Assets: index into the oracle table. Gold needs two feeds (USD/BCH and XAU/BCH).
int constant ASSET_BTC = 0;
int constant ASSET_ETH = 1;
int constant ASSET_BCH = 2;
int constant ASSET_GOLD = 3;
// USD/BCH is in cents, XAU/BCH in ounces × 100000, so usd × 10^7 ÷ xau is dollars per ounce × 10^4.
int constant GOLD_FACTOR = 10000000;

// Modes (high nibble of the mode byte); outcomes are the low nibble.
int constant MODE_UPDOWN = 0;
int constant MODE_RANGES = 1;
int constant NIBBLE = 16;
int constant MAX_OUTCOMES = 6;

// Stake classes (high nibble of the gate's class byte): satoshi bounds per entry and per gate.
int constant CLASS_SHORT = 0;
int constant CLASS_HOURLY = 1;
int constant CLASS_EVENT = 2;
int constant MIN_STAKE = 5000;
int constant SHORT_MAX_STAKE = 500000;
int constant HOURLY_MAX_STAKE = 5000000;
int constant EVENT_MAX_STAKE = 25000000;
int constant SHORT_GATE_CAP = 10000000;
int constant HOURLY_GATE_CAP = 100000000;
int constant EVENT_GATE_CAP = 500000000;

// Fees and dust (satoshis). Lifecycle fees are fixed so every client builds the same bytes; calibrated in S00 from
// measured sizes (gold settle ~1,840 B, gold lock with one gate ~1,940 B, ~190 B per swept P2SH32 ticket) with headroom.
// P2S tickets carry their ~112-byte script in the output: dust is 444 + 3 × ~188 B ≈ 1,008 sats, so 1,200.
int constant TICKET_DUST = 1200;
// Every gate is created holding exactly this; the lock counts anything beyond it as pot.
int constant GATE_DUST = 1000;
// An event entrant may leave before the lock; this share of the stake stays in the gate and joins the winners' pot.
int constant EVENT_EXIT_FEE_BPS = 300;
// P2PKH unlocking bytecode: 0x41 push, 64-byte Schnorr signature, then the sighash byte.
bytes constant SIGNATURE_PUSH = 0x41;
int constant SIGHASH_BYTE = 65;
int constant MIN_FEE_OUTPUT = 1000;
int constant LOCK_FEE_BASE = 1600;
int constant LOCK_FEE_PER_GATE = 700;
// An event gate's script is nearly twice a lane gate's (~690 bytes per merged gate, measured 2026-11-17: a 2-gate event
// lock is ~3,090 bytes, which 1,600 + 2 × 700 could not pay), so events pay more per gate.
int constant EVENT_LOCK_FEE_PER_GATE = 1100;
int constant SETTLE_FEE = 2200;
int constant SWEEP_FEE_BASE = 1000;
int constant SWEEP_FEE_PER_TICKET = 250;
// Each swept ticket costs ~20,000 operation-cost units; 32 padding bytes buy 25,600 (measured in S00).
int constant SWEEP_PAD_PER_TICKET = 32;
int constant PROTOCOL_FEE_BPS = 200;
int constant MAX_CREATOR_FEE_BPS = 300;
int constant BPS = 10000;

// Lifecycle transactions take every input at this sequence; the SDK default (0xfffffffe) would allow a second variant.
int constant FINAL_SEQUENCE = 4294967295;
// Timeout paths need a non-final sequence so the node enforces their locktime.
int constant TIMEOUT_SEQUENCE = 4294967294;
int constant TX_VERSION = 2;
// After T_close, how long settlement has before anyone may void the round (MTP lags about an hour on mainnet).
int constant SETTLE_TIMEOUT = 21600;

function maxStake(int stakeClass) returns (int) {
    require(stakeClass >= CLASS_SHORT && stakeClass <= CLASS_EVENT, "unknown stake class");
    int limit = SHORT_MAX_STAKE;
    if (stakeClass == CLASS_HOURLY) {
        limit = HOURLY_MAX_STAKE;
    } else if (stakeClass == CLASS_EVENT) {
        limit = EVENT_MAX_STAKE;
    }
    return limit;
}

function gateCap(int stakeClass) returns (int) {
    int cap = SHORT_GATE_CAP;
    if (stakeClass == CLASS_HOURLY) {
        cap = HOURLY_GATE_CAP;
    } else if (stakeClass == CLASS_EVENT) {
        cap = EVENT_GATE_CAP;
    }
    return cap;
}

// Gold in ten-thousandths of a US dollar per ounce, from the USD/BCH and XAU/BCH prices of the same minute.
function goldPrice(int usdPerBch, int xauPerBch) returns (int) {
    return usdPerBch * GOLD_FACTOR / xauPerBch;
}
