{
  "name": "@joge/contracts",
  "private": true,
  "type": "module",
  "description": "Jōge's covenants: CashScript round contracts (gates, tickets, the round master) and SolidCash lane threads, factory and agent vault, with their builders and tests.",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "build": "node scripts/compile.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "fixtures": "node scripts/fetch-fixtures.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "catalog:",
    "@electrum-cash/network": "catalog:",
    "@joge/sdk": "workspace:*",
    "@rpckit/core": "catalog:",
    "@rpckit/fallback": "catalog:",
    "@rpckit/websocket": "catalog:",
    "@solidcash/solidcash": "catalog:",
    "cashscript": "catalog:"
  },
  "devDependencies": {
    "@solidcash/solidc": "catalog:",
    "@types/node": "catalog:",
    "@wizardconnect/core": "catalog:",
    "@wizardconnect/dapp": "catalog:",
    "cashc": "catalog:",
    "typescript": "catalog:",
    "uqr": "catalog:"
  }
}
