pragma solidcash ^0.51.0;

import "./opening.scash";

// One lane (asset × length, e.g. BTC 5 min): a minting NFT of category K that opens the lane's rounds on a fixed time
// grid. Commitment: [0] tag 0x05 · [1] thread byte · [2] asset · [3,5) lane seconds · [5,9) next lock time · [9,12) counter
//
// open: anyone, for any grid slot at or after the next lock time and at most two lanes ahead of a signed oracle clock.
// It mints the round's master (opener = creator: budget back after the last payout, plus the lane opener fee) and
// its gates, then moves the lane's next lock time past the slot, so the same slot can never be opened twice.
contract LaneThread(
    bytes category,
    bytes masterLockingBytecode,
    bytes gateLockingBytecode,
    pubkey clockOracle
) {
    function open(bigint slot, bytes20 openerPkh, bytes clockMessage, datasig clockSignature) {
        require(this.activeInputIndex == 0, "the lane thread must be input 0");
        require(tx.inputs[0].tokenCategory == category + 0x02, "input 0 must be a lane thread of this category");
        bytes lane = tx.inputs[0].nftCommitment;
        require(lane.slice(0, 1) == TAG_LANE, "not a lane thread");

        bigint asset = bigint(lane.slice(2, 3));
        bigint laneSeconds = bigint(lane.slice(3, 5));
        bigint nextLock = bigint(lane.slice(5, 9));
        bigint counter = bigint(lane.slice(9, 12));
        require(slot >= nextLock && (slot - nextLock) % laneSeconds == 0, "the slot must be on the lane's grid, not yet opened");
        require(requireClockAtLeast(clockMessage, clockSignature, clockOracle, slot - 2 * laneSeconds), "clock");

        bigint stakeClass = CLASS_SHORT;
        if (laneSeconds >= HOUR) {
            stakeClass = CLASS_HOURLY;
        }
        bytes roundId = lane.slice(1, 2) + toPaddedBytes(counter, 3);
        bytes record = openRecord(
            roundId,
            asset,
            MODE_UPDOWN * NIBBLE + 2,
            LANE_GATES,
            slot,
            slot + laneSeconds,
            LANE_OPENER_FEE_BPS,
            bytes(openerPkh),
            0,
            0,
            0x
        );

        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "the lane thread comes back to itself");
        require(tx.outputs[0].tokenCategory == category + 0x02, "the lane keeps its minting NFT");
        require(tx.outputs[0].tokenAmount == 0, "no fungible tokens");
        require(
            tx.outputs[0].nftCommitment == lane.slice(0, 5) + toPaddedBytes(slot + laneSeconds, 4) + toPaddedBytes(counter + 1, 3),
            "the lane moves past this slot"
        );
        require(tx.outputs[0].value == tx.inputs[0].value, "the lane keeps its value");
        require(
            requireRoundOutputs(category, masterLockingBytecode, gateLockingBytecode, record, LANE_BUDGET, roundId, LANE_GATES, stakeClass, 2),
            "the round must open exactly"
        );
    }
}
