pragma solidcash ^0.51.0;

// SolidCash version of cashscript/Gate.cash (language bake-off; kept in step for BAKEOFF=1 runs).
import "../rules.scash";

// One of a round's G entry gates (a minting NFT of category K). Entries spread over gates so two players rarely race
// for the same coin. Commitment, at most 40 bytes because Selene refuses to sign inputs with longer commitments:
//   [0] tag 0x02 · [1,5) round id · [5] gate index · [6] stake class << 4 | outcomes
//   [7,10) live entrant count · [10, 10 + 5·N) stake total per outcome
contract Gate(bytes32 category, bytes ticketLockingBytecode) {
    // A player stakes on `outcome`. The player's authority is their own coin at input 1 (signed by their wallet);
    // the ticket records the payout address the winnings go to.
    function enter(bigint outcome, bigint stake, bytes20 payoutPkh) {
        require(this.activeInputIndex == 0, "the gate must be input 0");
        require(tx.inputs[0].tokenCategory == category + 0x02, "input 0 must be a gate");
        bytes state = tx.inputs[0].nftCommitment;
        require(state.slice(0, 1) == TAG_GATE, "not a gate commitment");

        bigint classAndOutcomes = bigint(state.slice(6, 7));
        bigint stakeClass = classAndOutcomes / NIBBLE;
        bigint outcomes = classAndOutcomes % NIBBLE;
        require(within(outcome, 0, outcomes), "no such outcome");
        require(within(stake, MIN_STAKE, maxStake(stakeClass) + 1), "stake outside this round's bounds");

        // New totals: one more entrant, the stake added to its outcome.
        bigint start = 10 + outcome * 5;
        bigint total = bigint(state.slice(start, start + 5));
        bigint entrants = bigint(state.slice(7, 10));
        bytes next = state.slice(0, 7) + toPaddedBytes(entrants + 1, 3) + state.slice(10, start)
            + toPaddedBytes(total + stake, 5) + state.slice(start + 5, state.length);

        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "gate must come back to itself");
        require(tx.outputs[0].tokenCategory == category + 0x02, "gate keeps its minting NFT");
        require(tx.outputs[0].tokenAmount == 0, "no fungible tokens");
        require(tx.outputs[0].nftCommitment == next, "gate totals must add this stake");
        require(tx.outputs[0].value == tx.inputs[0].value + stake, "gate must hold the stake");
        require(tx.outputs[0].value <= gateCap(stakeClass), "gate is full");

        bytes ticket = TAG_TICKET + state.slice(1, 6) + toPaddedBytes(outcome, 1) + toPaddedBytes(stake, 5) + payoutPkh;
        require(tx.outputs[1].lockingBytecode == ticketLockingBytecode, "output 1 must be the ticket");
        require(tx.outputs[1].tokenCategory == category, "ticket is an immutable NFT of the round's category");
        require(tx.outputs[1].tokenAmount == 0, "no fungible tokens");
        require(tx.outputs[1].nftCommitment == ticket, "ticket must record round, gate, outcome, stake and payee");
        require(tx.outputs[1].value == TICKET_DUST, "ticket carries the fixed dust");

        // Nothing else may carry tokens in or out (stops smuggling another ticket or leaking minting K).
        require(tx.outputs.length <= 3, "at most gate, ticket and change");
        bool changeIsPlain = true;
        if (tx.outputs.length == 3) {
            changeIsPlain = tx.outputs[2].tokenCategory == 0x;
        }
        for (bigint i = 1; i < tx.inputs.length; i++) {
            require(tx.inputs[i].tokenCategory == 0x, "funding inputs carry no tokens");
        }
        require(changeIsPlain, "change carries no tokens");
    }

    // The round's lock spends every gate together with its master; the master's lock function checks everything.
    function merge() {
        bytes own = tx.inputs[this.activeInputIndex].nftCommitment;
        bytes master = tx.inputs[0].nftCommitment;
        require(tx.inputs[0].tokenCategory == category + 0x01, "input 0 must be the round master");
        require(master.slice(0, 1) == TAG_MASTER, "not a master commitment");
        require(master.slice(5, 6) == STATE_OPEN, "the round is not open");
        require(master.slice(1, 5) == own.slice(1, 5), "the master belongs to another round");
    }
}
