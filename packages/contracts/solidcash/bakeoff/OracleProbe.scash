pragma solidcash ^0.51.0;

import "../oracle.scash";

// Test only: the oracle module in SolidCash, run against the same real boundaries as the CashScript probe.
contract OracleProbe(pubkey oracle) {
    function boundary(
        bytes previous,
        datasig previousSignature,
        bytes first,
        datasig firstSignature,
        int boundaryTime,
        int expectedSequence
    ) {
        int sequence = firstAtOrAfter(previous, previousSignature, first, firstSignature, oracle, boundaryTime);
        require(sequence == expectedSequence);
    }

    function strike(bytes message, datasig signature, int sequence, int expectedPrice) {
        require(priceAtSequence(message, signature, oracle, sequence) == expectedPrice);
    }
}
