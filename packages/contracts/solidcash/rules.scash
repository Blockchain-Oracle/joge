pragma solidcash ^0.51.0;

// Jōge's shared rules: NFT tags, round states, stake classes and fixed lifecycle fees.
// Generated from cashscript/rules.cash (same values); mirrored in packages/sdk/src/round/constants.ts.

// First byte of every commitment of category K.
bytes1 constant TAG_MASTER = 0x01;
bytes1 constant TAG_GATE = 0x02;
bytes1 constant TAG_TICKET = 0x03;

// Master state byte (offset 5).
bytes1 constant STATE_OPEN = 0x00;
bytes1 constant STATE_LOCKED = 0x01;
bigint constant STATE_SETTLED = 2;
bigint constant STATE_VOID = 3;

// Assets: index into the oracle table. Gold needs two feeds (USD/BCH and XAU/BCH).
bigint constant ASSET_BTC = 0;
bigint constant ASSET_ETH = 1;
bigint constant ASSET_BCH = 2;
bigint constant ASSET_GOLD = 3;
// USD/BCH is in cents, XAU/BCH in ounces × 100000, so usd × 10^7 ÷ xau is dollars per ounce × 10^4.
bigint constant GOLD_FACTOR = 10000000;

// Modes (high nibble of the mode byte); outcomes are the low nibble.
bigint constant MODE_UPDOWN = 0;
bigint constant MODE_RANGES = 1;
bigint constant NIBBLE = 16;
bigint constant MAX_OUTCOMES = 6;

// Stake classes (high nibble of the gate's class byte): satoshi bounds per entry and per gate.
bigint constant CLASS_SHORT = 0;
bigint constant CLASS_HOURLY = 1;
bigint constant CLASS_EVENT = 2;
bigint constant MIN_STAKE = 5000;
bigint constant SHORT_MAX_STAKE = 500000;
bigint constant HOURLY_MAX_STAKE = 5000000;
bigint constant EVENT_MAX_STAKE = 25000000;
bigint constant SHORT_GATE_CAP = 10000000;
bigint constant HOURLY_GATE_CAP = 100000000;
bigint constant EVENT_GATE_CAP = 500000000;

// Fees and dust (satoshis). Lifecycle fees are fixed so every client builds the same bytes; calibrated on chipnet from
// measured sizes (gold settle ~1,840 B, gold lock with one gate ~1,940 B, ~190 B per swept P2SH32 ticket) with headroom.
// P2S tickets carry their ~112-byte script in the output: dust is 444 + 3 × ~188 B ≈ 1,008 sats, so 1,200.
bigint constant TICKET_DUST = 1200;
// Every gate is created holding exactly this; the lock counts anything beyond it as pot.
bigint constant GATE_DUST = 1000;
// An event entrant may leave before the lock; this share of the stake stays in the gate and joins the winners' pot.
bigint constant EVENT_EXIT_FEE_BPS = 300;
// P2PKH unlocking bytecode: 0x41 push, 64-byte Schnorr signature, then the sighash byte.
bytes1 constant SIGNATURE_PUSH = 0x41;
bigint constant SIGHASH_BYTE = 65;
bigint constant MIN_FEE_OUTPUT = 1000;
bigint constant LOCK_FEE_BASE = 1600;
bigint constant LOCK_FEE_PER_GATE = 700;
bigint constant SETTLE_FEE = 2200;
bigint constant SWEEP_FEE_BASE = 1000;
bigint constant SWEEP_FEE_PER_TICKET = 250;
// Each swept ticket costs ~20,000 operation-cost units; 32 padding bytes buy 25,600 (measured).
bigint constant SWEEP_PAD_PER_TICKET = 32;
bigint constant PROTOCOL_FEE_BPS = 200;
bigint constant MAX_CREATOR_FEE_BPS = 300;
bigint constant BPS = 10000;

// Lifecycle transactions take every input at this sequence; the SDK default (0xfffffffe) would allow a second variant.
bigint constant FINAL_SEQUENCE = 4294967295;
// Timeout paths need a non-final sequence so the node enforces their locktime.
bigint constant TIMEOUT_SEQUENCE = 4294967294;
bigint constant TX_VERSION = 2;
// After T_close, how long settlement has before anyone may void the round (MTP lags about an hour on mainnet).
bigint constant SETTLE_TIMEOUT = 21600;

function maxStake(bigint stakeClass) returns (int) {
    require(stakeClass >= CLASS_SHORT && stakeClass <= CLASS_EVENT, "unknown stake class");
    bigint limit = SHORT_MAX_STAKE;
    if (stakeClass == CLASS_HOURLY) {
        limit = HOURLY_MAX_STAKE;
    } else if (stakeClass == CLASS_EVENT) {
        limit = EVENT_MAX_STAKE;
    }
    return limit;
}

function gateCap(bigint stakeClass) returns (int) {
    bigint cap = SHORT_GATE_CAP;
    if (stakeClass == CLASS_HOURLY) {
        cap = HOURLY_GATE_CAP;
    } else if (stakeClass == CLASS_EVENT) {
        cap = EVENT_GATE_CAP;
    }
    return cap;
}

// Gold in ten-thousandths of a US dollar per ounce, from the USD/BCH and XAU/BCH prices of the same minute.
function goldPrice(bigint usdPerBch, bigint xauPerBch) returns (int) {
    return usdPerBch * GOLD_FACTOR / xauPerBch;
}
