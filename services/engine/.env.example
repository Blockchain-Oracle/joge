# Jōge engine: copy to services/engine/.env and fill in. Never commit the real file.
# Only DATABASE_URL is required; each optional key switches a part on.

DATABASE_URL=postgres://joge:joge@localhost:5432/joge
# chipnet or mainnet
JOGE_NETWORK=chipnet
# Which parts run: oracle,price,indexer,keeper,agents,push,paths,faucet (all when unset)
# ENGINE_COMPONENTS=oracle,price,indexer,keeper,paths
# Comma-separated Fulcrum WebSocket URLs (public servers for the network when unset)
# FULCRUM_URLS=

# Keeper: its funding key (WIF) opens lanes; lock, settle and pay need no key
KEEPER_WIF=
# Lane threads kept open (hex like 0x11,0x14) or "all"
KEEPER_LANES=all
# "on": lanes outside KEEPER_LANES open while someone is looking at them
KEEPER_DEMAND=off

# Agents: the master private key that signs vault bets, and the model for their reads
AGENT_XPRV=
OPENAI_API_KEY=
AI_MODEL=openai/gpt-5.4-mini
AGENT_MAX_CALLS_PER_HOUR=60

# Web Push alerts (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Chipnet faucet key (WIF); chipnet only
FAUCET_WIF=
# Chipnet test players for scripts/chipnet-players.ts (created on first run)
# CHIPNET_PLAYER_WIF=
