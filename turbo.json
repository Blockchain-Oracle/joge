{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": ["DATABASE_URL", "NEXT_DEPLOYMENT_ID"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**", "artifacts/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] }
  }
}
